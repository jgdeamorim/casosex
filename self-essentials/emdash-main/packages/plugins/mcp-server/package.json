{
	"name": "@emdash-cms/plugin-mcp-server",
	"version": "0.1.0",
	"description": "Sovereign MCP Server plugin for EmDash CMS - exposes JSON-RPC 2.0 AI agent tools and admin cockpit",
	"type": "module",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs"
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc"
	],
	"keywords": [
		"emdash",
		"cms",
		"plugin",
		"mcp",
		"ai-agent",
		"json-rpc"
	],
	"author": "Jeferson Amorim / Adsentice",
	"license": "MIT",
	"peerDependencies": {
		"emdash": "workspace:>=0.15.0"
	},
	"devDependencies": {
		"@emdash-cms/plugin-cli": "workspace:*",
		"typescript": "catalog:"
	},
	"scripts": {
		"build": "node node_modules/@emdash-cms/plugin-cli/dist/index.mjs build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit"
	}
}
