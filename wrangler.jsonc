{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "casosex-cms",
	"compatibility_date": "2026-01-14",
	"compatibility_flags": ["nodejs_compat", "disable_nodejs_process_v2"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "casosex_db"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "casosex-media"
		}
	],
	"observability": {
		"enabled": true
	}
}
