  <body class="bg-obsidian-950 text-white font-body antialiased min-h-screen flex flex-col justify-center items-center p-6 text-center">
    <main class="max-w-2xl bg-obsidian-900/60 border border-glass-border backdrop-blur-md p-10 rounded-3xl shadow-2xl space-y-6">
