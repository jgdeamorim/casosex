---
import Base from "../../layouts/Base.astro";

const { slug } = Astro.params;
const title = slug ? slug.charAt(0).toUpperCase() + slug.slice(1) : "Página";
---

<Base title={title}>
	<article class="page-article">
		<header class="page-header">
			<h1 class="page-title">{title}</h1>
		</header>

		<div class="page-content">
			<p>Conteúdo da página em atualização.</p>
		</div>
	</article>
</Base>

<style>
	.page-article {
		max-width: 800px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}

	.page-header {
		margin-bottom: 2rem;
	}

	.page-title {
		font-size: 2.25rem;
		font-weight: 700;
	}
</style>
