{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CASOSEX Brand DNA & Design System Specification (2026+)",
  "version": "1.1.0",
  "project": "CASOSEX",
  "author": "Jeferson Amorim (Founder) & Antigravity (AI Architect)",
  "date": "2026-08-26",
  "brand_dna": {
    "positioning": "Erotic Luxury & High-End Sensual Lifestyle (SMB Brasil)",
