  "design_tokens_tailwind_v4": {
    "colors": {
      "obsidian_deep": "#0D0A0F",
      "obsidian_950": "#09090B",
      "obsidian_900": "#121215",
      "obsidian_card": "rgba(28, 20, 30, 0.78)",
      "crimson_600": "#E11D48",
      "rose_soft": "#FB7185",
      "gold_champagne": "#D4A373",
      "gold_light": "#F5D0A9",
      "coral_accent": "#F9603F",
      "emerald_pix_500": "#10B981",
      "emerald_pix_400": "#34D399",
