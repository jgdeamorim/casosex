  "brand_logo_spec": {
    "font_family": "Playfair Display, serif",
    "weight": 700,
    "transform": "uppercase",
    "letter_spacing": "0.16em",
    "fill_gradient": "linear-gradient(180deg, #FFFFFF 0%, #E2D7CE 60%, #D4A373 100%)",
    "tagline_font": "Playfair Display, serif (italic 400)",
